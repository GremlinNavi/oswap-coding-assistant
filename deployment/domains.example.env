# Deployment-only values. Do not commit real credentials or private origin data.
# The OSWAP domains are registered for future use, but this example file does not
# represent any OSWAP website or subdomain as currently deployed or online.
OSWAP_DEPLOY_TARGET_CA=your-app-host.example
OSWAP_DEPLOY_TARGET_US=your-app-host.example
OSWAP_DEPLOY_TARGET_JP=your-app-host.example

# Optional runtime hostname override for LOCAL MANIFEST TESTING ONLY.
# This value is a planned hostname identity; using it does not perform DNS resolution
# and is not evidence that ai.oswap.ca is reachable.
OSWAP_HOSTNAME=ai.oswap.ca
